rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Validator
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'studiedCount', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 4 &&
             data.name is string && data.name.size() <= 100 &&
             data.studiedCount is number && data.studiedCount >= 0 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.studiedCount is number && data.studiedCount >= 0 &&
             data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidId(userId) && 
                    isValidUser(incoming());
      allow update: if isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidId(userId) && 
                    isValidUserUpdate(incoming()) &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'studiedCount', 'updatedAt']);
    }

    // Deck Validator
    function isValidDeck(data, authUid) {
      return data.keys().hasAll(['userId', 'title', 'cards', 'date', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 6 &&
             data.userId == authUid &&
             data.title is string && data.title.size() <= 200 &&
             data.date is string && data.date.size() <= 50 &&
             data.cards is list && data.cards.size() <= 100 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidDeckUpdate(data, authUid) {
      return data.title is string && data.title.size() <= 200 &&
             data.userId == authUid &&
             data.date is string && data.date.size() <= 50 &&
             data.cards is list && data.cards.size() <= 100 &&
             data.updatedAt == request.time;
    }

    match /decks/{deckId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && 
                    isValidId(deckId) && 
                    isValidDeck(incoming(), request.auth.uid) &&
                    exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSignedIn() && 
                    isValidId(deckId) && 
                    resource.data.userId == request.auth.uid &&
                    isValidDeckUpdate(incoming(), request.auth.uid) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['title', 'cards', 'date', 'updatedAt']);
      allow delete: if isSignedIn() && 
                    isValidId(deckId) && 
                    resource.data.userId == request.auth.uid;
    }
  }
}
